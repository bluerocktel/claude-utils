#!/bin/bash
# claude-plans: generate plans for all tasks in ~/tasks/plan/ in parallel
#
# Usage: claude-plans

PLAN_DIR=~/tasks/plan

TASKS=("$PLAN_DIR"/*.md)

if [ ! -f "${TASKS[0]}" ]; then
    echo "No .md task files found in $PLAN_DIR"
    exit 1
fi

COUNT=0
for TASK_FILE in "${TASKS[@]}"; do
    "$HOME/bin/claude-plan" "$TASK_FILE"
    COUNT=$((COUNT + 1))
done

echo ""
echo "$COUNT planning task(s) launched in parallel."
echo "List sessions : tmux ls"
