#!/bin/bash
# claude-plan: generate an implementation plan for a task in ~/tasks/plan/
#
# Usage:
#   claude-plan [task.md]     Plan task (picks oldest from ~/tasks/plan/ if no arg)
#   claude-plan --run FILE    Internal mode used by tmux (do not call directly)

PLAN_DIR=~/tasks/plan
RUN_DIR=~/tasks/run
PLANNED_DIR=~/tasks/planned

# ── Internal execution mode ────────────────────────────────────────────────
if [ "$1" = "--run" ]; then
    TASK_FILE="$2"
    TASK_NAME=$(basename "$TASK_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
    RESULT_FILE="$PLANNED_DIR/${TIMESTAMP}_${TASK_NAME}.md"

    touch "$RESULT_FILE"
    tail -f "$RESULT_FILE" &
    TAIL_PID=$!

    PREAMBLE="PLANNING MODE: Produce an implementation plan only. Do not write code, edit files, or run shell commands. Analyze the task and output a single ready-to-execute Markdown task file with the following sections:
- ## Context: restate goals and relevant background.
- ## Implementation Plan: numbered steps, files to create or modify, rationale for each change.
- ## Risks and Assumptions: open questions the executor should be aware of.
- ## Tasks: concrete numbered instructions for autonomous execution.
The output will be passed directly to another Claude instance running autonomously via claude-task. Be precise and complete."

    claude --dangerously-skip-permissions -p "$PREAMBLE

$(cat "$TASK_FILE")" > "$RESULT_FILE" 2>&1
    STATUS=$?

    kill $TAIL_PID 2>/dev/null
    wait $TAIL_PID 2>/dev/null

    # Move original back to plan/ without .md
    mv "$TASK_FILE" "$PLAN_DIR/$(basename "$TASK_FILE" .md)"

    if [ $STATUS -eq 0 ]; then
        notify-send "Claude: Plan Ready" "$TASK_NAME. Review in ~/tasks/planned/"
    else
        notify-send -u critical "Claude: Plan Failed" "$TASK_NAME planning failed. See $RESULT_FILE"
    fi

    exit $STATUS
fi

# ── Launcher mode ──────────────────────────────────────────────────────────
if [ -n "$1" ]; then
    TASK_FILE="$1"
else
    TASK_FILE=$(ls -tr "$PLAN_DIR"/*.md 2>/dev/null | head -1)
fi

if [ -z "$TASK_FILE" ] || [ ! -f "$TASK_FILE" ]; then
    echo "Usage: claude-plan [task.md]"
    echo "No .md task file found in $PLAN_DIR"
    exit 1
fi

TASK_NAME=$(basename "$TASK_FILE" .md)
SESSION="claude-plan-${TASK_NAME}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Session '$SESSION' already running. Attach: tmux attach -t $SESSION"
    exit 1
fi

mkdir -p "$RUN_DIR"
mv "$TASK_FILE" "$RUN_DIR/"
TASK_FILE="$RUN_DIR/$(basename "$TASK_FILE")"

tmux new-session -d -s "$SESSION" bash -lc "\"$HOME/bin/claude-plan\" --run \"$TASK_FILE\""

echo "Planning '$TASK_NAME' started in tmux session '$SESSION'."
echo "Monitor : tmux attach -t $SESSION"
echo "Result  : $PLANNED_DIR/*_${TASK_NAME}.md"
