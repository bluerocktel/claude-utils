#!/bin/bash
# ltask: list tasks across all pipeline stages

BACKLOG_DIR=~/tasks/backlog
BACKLOG_REVIEW_DIR=~/tasks/backlog-for-review
INBOX=~/tasks/inbox
RUN_DIR=~/tasks/run
REVIEW_DIR=~/tasks/review

_count_and_list() {
    local label="$1"
    local dir="$2"
    local files=("$dir"/*.md)
    local count=0

    if [ -f "${files[0]}" ]; then
        count=${#files[@]}
    fi

    echo "$label ($count):"
    if [ "$count" -eq 0 ]; then
        echo "  (empty)"
    else
        for f in "${files[@]}"; do
            echo "  - $(basename "$f" .md)"
        done
    fi
    echo ""
}

_count_and_list "Backlog"            "$BACKLOG_DIR"
_count_and_list "Backlog for review" "$BACKLOG_REVIEW_DIR"
_count_and_list "Inbox"              "$INBOX"
_count_and_list "Running"            "$RUN_DIR"
_count_and_list "Review"             "$REVIEW_DIR"
