#!/bin/bash
# ltask: list tasks - show plan, inbox, and running tasks

PLAN_DIR=~/tasks/plan
PLANNED_DIR=~/tasks/planned
INBOX=~/tasks/inbox
RUN_DIR=~/tasks/run

_count_and_list() {
    local label="$1"
    local dir="$2"
    local files=("$dir"/*.md)
    local count=0

    if [ -f "${files[0]}" ]; then
        count=${#files[@]}
    fi

    echo "$label ($count):"
    if [ "$count" -eq 0 ]; then
        echo "  (empty)"
    else
        for f in "${files[@]}"; do
            echo "  - $(basename "$f" .md)"
        done
    fi
    echo ""
}

_count_and_list "Plan"    "$PLAN_DIR"
_count_and_list "Planned" "$PLANNED_DIR"
_count_and_list "Inbox"   "$INBOX"
_count_and_list "Running" "$RUN_DIR"
