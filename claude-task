#!/bin/bash
# claude-task: run a Claude task autonomously in a detached tmux session
#
# Usage:
#   claude-task [task.md]     Launch task (picks oldest from ~/tasks/inbox/ if no arg)
#   claude-task --run FILE    Internal mode used by tmux (do not call directly)

INBOX=~/tasks/inbox
RUN_DIR=~/tasks/run
DONE_DIR=~/tasks/done
REVIEW_DIR=~/tasks/review
SUGGEST_DIR=~/tasks/suggestions          # machine-proposed follow-up task stubs (user reviews)
BACKLOG_DIR=~/tasks/backlog
BACKLOG_REVIEW_DIR=~/tasks/backlog-for-review
PROJECTS_DIR=~/tasks/projects
LOG=~/tasks/DONE.md
COOLDOWN=~/tasks/.auth-cooldown   # marker dropped on an auth failure; pauses launches

# True if the file contains the signature of an auth/credentials failure
# (expired token, 401). Such a failure means no work was done — it must never
# be counted as a task failure or burn a retry.
is_auth_failure() {
    grep -qiE 'API Error: 401|Invalid authentication credentials|OAuth token (has )?expired|Failed to authenticate' "$1"
}

# True if a task with this slug already exists anywhere in the pipeline, so a
# follow-up suggestion is never a duplicate of something already queued, in
# review, or already completed. Matches a bare `<slug>.md` and a prefix-
# separated `*_<slug>.md` (date-prefixed backlog/done files), but not a mere
# substring, to avoid false positives.
slug_exists() {
    local slug="$1" d
    for d in "$INBOX" "$SUGGEST_DIR" "$BACKLOG_DIR" "$BACKLOG_REVIEW_DIR"; do
        [ -f "$d/${slug}.md" ] && return 0
        ls "$d"/*_"${slug}".md >/dev/null 2>&1 && return 0
    done
    ls "$DONE_DIR"/*_"${slug}".task.md >/dev/null 2>&1 && return 0
    return 1
}

# ── Follow-up task suggester ─────────────────────────────────────────────────
# Called ONLY from the verified-success branch (run completed AND passed
# evaluation), BEFORE the task file is archived to done/. Proposes SAME-PROJECT
# follow-up task stubs — a natural continuation of the work just finished — into
# ~/tasks/suggestions/ for the user to promote or discard. This is a per-task
# reflex with single-task tunnel vision; cross-project propagation and strategic
# synthesis across the whole pipeline are now owned by the `planner` kind in
# claude-scheduled (which reads recent done/, project roadmaps, the queues, and
# review/ failures). Read-only w.r.t. the working tree: it reads the task and its
# result report (author-scoped to THIS task), never a git diff, which could
# include concurrent sibling-task changes. Sets SUGGEST_COUNT.
# Relies on globals: PROJECT, TASK_FILE, TASK_NAME, RESULT_FILE, MODEL_FLAG,
# SUGGEST_ENABLED, SUGGEST_MAX.
generate_suggestions() {
    SUGGEST_COUNT=0
    [ "$SUGGEST_ENABLED" = "1" ] || return 0
    [ -n "$PROJECT" ] || return 0        # no ## Project → no target attribution
    mkdir -p "$SUGGEST_DIR"

    local sug_tmp sug_err
    sug_tmp=$(mktemp); sug_err=$(mktemp)
    claude --dangerously-skip-permissions $MODEL_FLAG -p \
"SUGGESTER MODE: A task just completed and passed evaluation in project '$PROJECT'. Propose SAME-PROJECT follow-up task stubs the user may want to queue next in this same project.

Rules:
- Silence is the default. Only suggest work you would genuinely bet is worth doing. Zero suggestions is a correct and common answer.
- Suggest AT MOST $SUGGEST_MAX stubs, ALL in project '$PROJECT' — a natural continuation of the work just finished.
- Do NOT propose cross-project work: mirroring this change into another app, or turning it into content elsewhere. Cross-project propagation and strategic multi-task synthesis are handled separately by the scheduled planner, not here.
- Do NOT suggest anything the result report already implies is done, nor trivial/obvious cleanup.
- Each stub must be concrete: a clear title, what to do, and acceptance criteria. Scope each to under ~5 files; split otherwise.

Output ONLY the stubs, each fenced EXACTLY as below, with no preamble and no closing remark. If you have no worthwhile suggestions, output the single line: NONE

===SUGGESTION===
slug: <kebab-case-unique-slug>
project: $PROJECT
kind: same-project
---
# <Title>

## Project
$PROJECT

## Origin
Suggested after '$TASK_NAME' completed in '$PROJECT'.

<body: what to do, plus acceptance criteria>
===END===

--- ORIGINAL TASK ---
$(cat "$TASK_FILE")

--- RESULT REPORT (what was done) ---
$(cat "$RESULT_FILE")" --output-format json > "$sug_tmp" 2>"$sug_err"

    local sug_text
    sug_text=$(jq -r '.result // ""' "$sug_tmp" 2>/dev/null)
    rm -f "$sug_tmp" "$sug_err"

    [ -z "$sug_text" ] && { echo "[suggester] empty response for $TASK_NAME"; return 0; }
    if printf '%s' "$sug_text" | grep -qx 'NONE'; then
        echo "[suggester] no follow-ups proposed for $TASK_NAME"
        return 0
    fi

    # Split the fenced stubs into per-stub temp files.
    local parse_dir; parse_dir=$(mktemp -d)
    awk -v dir="$parse_dir" '
        /^===SUGGESTION===/ { n++; cur=sprintf("%s/stub-%03d", dir, n); inblk=1; next }
        /^===END===/ { inblk=0; next }
        inblk { print > cur }
    ' <<< "$sug_text"

    local written=0 skipped=0 f slug
    for f in "$parse_dir"/stub-*; do
        [ -f "$f" ] || continue
        if [ "$written" -ge "$SUGGEST_MAX" ]; then skipped=$((skipped+1)); continue; fi
        slug=$(awk -F': *' '/^slug:/{print $2; exit}' "$f" | tr -cd '[:alnum:]-')
        if [ -z "$slug" ]; then skipped=$((skipped+1)); continue; fi
        if slug_exists "$slug"; then
            echo "[suggester] skip '$slug' (already exists in pipeline)"
            skipped=$((skipped+1)); continue
        fi
        # Body is everything after the first '---' separator line.
        awk 'p{print} /^---$/{p=1}' "$f" > "$SUGGEST_DIR/${slug}.md"
        echo "[suggester] wrote suggestion: $slug"
        written=$((written+1))
    done
    rm -rf "$parse_dir"
    SUGGEST_COUNT=$written
    echo "[suggester] $TASK_NAME -> $written suggestion(s) written, $skipped skipped"
}

# ── Internal execution mode ────────────────────────────────────────────────
if [ "$1" = "--run" ]; then
    TASK_FILE="$2"
    TASK_NAME=$(basename "$TASK_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
    RESULT_FILE="$DONE_DIR/${TIMESTAMP}_${TASK_NAME}.md"

    # Source config for MAX_RETRIES (default 3); set max_retries=N in config to override
    SCRIPT_DIR="$(dirname "$(realpath "$0")")"
    CONFIG="$SCRIPT_DIR/config"
    MAX_RETRIES=3
    TASK_TIMEOUT_MIN=45          # hard wall-clock cap on the main claude -p call
    PROJECT_LOCK_WAIT_MIN=60     # how long a sibling waits for the project lock
    SUGGEST_ENABLED=1            # emit follow-up suggestions after a verified success
    SUGGEST_MAX=3                # per-task cap on suggestions written
    [ -f "$CONFIG" ] && {
        source "$CONFIG"
        MAX_RETRIES=${max_retries:-3}
        TASK_TIMEOUT_MIN=${task_timeout_min:-45}
        PROJECT_LOCK_WAIT_MIN=${project_lock_wait_min:-60}
        SUGGEST_ENABLED=${suggest_enabled:-1}
        SUGGEST_MAX=${suggest_max:-3}
    }
    mkdir -p "$REVIEW_DIR"

    # ── Per-project serialization ──────────────────────────────────────────────
    # Tasks that share a ## Project mutate the same git working tree (and DB), so
    # running them concurrently races — one task's half-written file breaks
    # another's test run (the cause of repeated test-task retries). Hold an
    # exclusive per-project lock for the whole run; a sibling waits instead of
    # corrupting the tree. If the lock can't be taken within the wait window,
    # requeue UNCHANGED (no retry burned) so a later pass retries once free.
    PROJECT=$(awk '/^## Project/{found=1; next} found && /^[^#]/{print $1; exit} found && /^##/{exit}' "$TASK_FILE")
    if [ -n "$PROJECT" ]; then
        LOCK_DIR=~/tasks/.locks
        mkdir -p "$LOCK_DIR"
        exec 9>"$LOCK_DIR/${PROJECT}.lock"
        if ! flock -w "$((PROJECT_LOCK_WAIT_MIN * 60))" 9; then
            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Status:** DEFERRED (project '$PROJECT' busy — lock wait timed out, not counted as retry)"
                echo ""
            } >> "$LOG"
            mv "$TASK_FILE" "$INBOX/${TASK_NAME}.md"
            exit 0
        fi
    fi

    {
        echo "# $TASK_NAME"
        echo ""
        echo "**Started:** $(date '+%Y-%m-%d %H:%M')"
        echo ""
        echo "---"
        echo ""
    } > "$RESULT_FILE"

    PREAMBLE="AUTONOMOUS MODE: You have no user to interact with. Never ask questions, never present options, never wait for confirmation. Make decisions and implement immediately. There is no event loop in this headless run: never wait on a Monitor event, a scheduled wakeup, a task notification, or any asynchronous callback — those never fire here and the run will simply be killed. If a step needs test results or command output, run it SYNCHRONOUSLY, block on it, and read its output before continuing; if something genuinely cannot complete in one pass, finish now and record what remains in the ## Summary instead of parking to wait. Document choices in a ## Summary at the end. After the ## Summary, always add a ## Tools Used section listing: (1) Agents: any agents from ~/.claude/agents/ that were invoked (list by name, or 'none'); (2) Skills: any skills that were invoked (list by name, or 'none'). After ## Tools Used, add a ## Suggested Commit Message section containing a ready-to-use git commit message (subject line + optional body) that accurately describes all changes made. Do not run git commit yourself. CRITICAL: Never use git checkout, git restore, or git reset to undo a previous attempt's changes. Any untracked files or unstaged modifications you find in the working tree may be legitimate work from other concurrently-running tasks — do not delete or revert them. If you need to undo your own specific changes from a previous attempt, edit only the exact lines you added."

    # Resolve optional model override from task frontmatter (## Model field)
    MODEL_FLAG=""
    RAW_MODEL=$(awk '/^## Model/{found=1; next} found && /^[^#]/{print; exit}' "$TASK_FILE" | tr -d '[:space:]')
    case "$RAW_MODEL" in
        opus)   MODEL_FLAG="--model claude-opus-4-8" ;;
        sonnet) MODEL_FLAG="--model claude-sonnet-5" ;;
        haiku)  MODEL_FLAG="--model claude-haiku-4-5-20251001" ;;
        fable)  MODEL_FLAG="--model claude-fable-5" ;;
        "")     MODEL_FLAG="" ;;
        *)      MODEL_FLAG="--model $RAW_MODEL" ;;
    esac

    # Detect ## Workflow flag — if present, run as a dynamic workflow via ultracode
    WORKFLOW_PREFIX=""
    WORKFLOW_LABEL=""
    if grep -q "^## Workflow" "$TASK_FILE"; then
        WORKFLOW_PREFIX="ultracode: "
        WORKFLOW_LABEL=" (workflow)"
    fi

    JSON_TMP=$(mktemp)
    ERR_TMP=$(mktemp)
    TOKEN_TMP=$(mktemp)

    # --output-format json captures usage stats; no live streaming to RESULT_FILE during execution.
    # stderr MUST go to a separate file: merging it into stdout (2>&1) prepends
    # warnings (e.g. the "workspace has not been trusted" notice) to the JSON and
    # breaks jq, which silently empties the report. Auth detection scans both.
    # Hard wall-clock cap: `timeout` sends SIGTERM (exit 124) if the run overruns,
    # so a parked/runaway task fails predictably here instead of waiting for an
    # arbitrary external killer. Exit 124 (no parseable result) is caught by the
    # interrupted-run handler below and deferred without burning a retry.
    timeout "$((TASK_TIMEOUT_MIN * 60))" \
        claude --dangerously-skip-permissions $MODEL_FLAG -p "${WORKFLOW_PREFIX}${PREAMBLE}

$(cat "$TASK_FILE")" --output-format json > "$JSON_TMP" 2>"$ERR_TMP"
    STATUS=$?

    # ── Auth-failure circuit-breaker ─────────────────────────────────────────
    # A 401/expired-token means no work happened. Defer the task back to the
    # inbox UNCHANGED (no retry burned, not sent to review), drop a cooldown
    # marker so the launcher stops hammering, and bail out. The queue resumes
    # automatically once the user re-authenticates.
    if is_auth_failure "$JSON_TMP" || is_auth_failure "$ERR_TMP"; then
        {
            echo "Deferred: authentication failure (no work performed, retry not counted)."
            echo "$(jq -r '.result // ""' "$JSON_TMP" 2>/dev/null)"
            echo ""
            echo "---"
            echo ""
            echo "**Deferred:** $(date '+%Y-%m-%d %H:%M') — requeued to inbox pending re-authentication."
        } >> "$RESULT_FILE"
        {
            echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
            echo ""
            echo "**Status:** DEFERRED (auth failure — not counted as retry)"
            echo "**Result:** \`$RESULT_FILE\`"
            echo ""
        } >> "$LOG"
        touch "$COOLDOWN"
        mv "$TASK_FILE" "$INBOX/${TASK_NAME}.md"
        rm -f "$JSON_TMP" "$ERR_TMP" "$TOKEN_TMP"
        notify-send -u critical "Claude: Auth Failure" "$TASK_NAME${WORKFLOW_LABEL} deferred — re-authenticate (e.g. /login). Queue paused for cooldown."
        exit 0
    fi

    # Auth is working — clear any stale cooldown marker so the queue resumes.
    rm -f "$COOLDOWN"

    # ── Killed / interrupted run ─────────────────────────────────────────────
    # A non-zero exit from `claude -p` with no parseable result means the run
    # was interrupted (e.g. SIGTERM → exit 143 when a headless task parks itself
    # waiting on an event that never fires). No verdict is possible, so — like an
    # auth failure — requeue the task to the inbox UNCHANGED: no retry burned,
    # never sent to the evaluator (which would read the empty report as FAIL),
    # and never left orphaned in run/. If the run exited non-zero but still
    # produced a result, fall through and let the evaluator judge it.
    if [ "$STATUS" -ne 0 ] && [ -z "$(jq -r '.result // empty' "$JSON_TMP" 2>/dev/null)" ]; then
        if [ "$STATUS" -eq 124 ]; then
            INTERRUPT_REASON="timed out after ${TASK_TIMEOUT_MIN}m"
        else
            INTERRUPT_REASON="interrupted (exit code $STATUS)"
        fi
        {
            echo "Deferred: run $INTERRUPT_REASON, no output — retry not counted."
            echo ""
            echo "---"
            echo ""
            echo "**Deferred:** $(date '+%Y-%m-%d %H:%M') — requeued to inbox (killed/interrupted run)."
        } >> "$RESULT_FILE"
        {
            echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
            echo ""
            echo "**Status:** DEFERRED (run $INTERRUPT_REASON — not counted as retry)"
            echo "**Result:** \`$RESULT_FILE\`"
            echo ""
        } >> "$LOG"
        mv "$TASK_FILE" "$INBOX/${TASK_NAME}.md"
        rm -f "$JSON_TMP" "$ERR_TMP" "$TOKEN_TMP"
        notify-send -u critical "Claude: Task Interrupted" "$TASK_NAME${WORKFLOW_LABEL} $INTERRUPT_REASON — requeued, no retry burned."
        exit 0
    fi

    # Write Claude's response text to the result file. If the JSON could not be
    # parsed (empty .result despite a non-empty capture), fall back to the raw
    # stdout + any stderr so the report is never silently blank — a parse glitch
    # then degrades to "ugly but present" instead of an empty, misleading report.
    RESULT_TEXT=$(jq -r '.result // empty' "$JSON_TMP" 2>/dev/null)
    if [ -z "$RESULT_TEXT" ] && { [ -s "$JSON_TMP" ] || [ -s "$ERR_TMP" ]; }; then
        {
            echo "> [claude-task] WARNING: could not parse Claude JSON output (.result empty)."
            echo "> Raw stdout and stderr captures follow."
            echo ""
            echo "_stdout:_"
            echo '```'
            cat "$JSON_TMP"
            echo '```'
            echo ""
            echo "_stderr:_"
            echo '```'
            cat "$ERR_TMP"
            echo '```'
        } > "$TOKEN_TMP.result"
    else
        printf '%s\n' "$RESULT_TEXT" > "$TOKEN_TMP.result"
    fi

    # Build token usage section
    {
        echo "## Token Usage"
        echo ""
        echo "| Model | Input | Output | Cache Read | Cache Write | Cost |"
        echo "|-------|-------|--------|------------|-------------|------|"
        jq -r '.modelUsage | to_entries[] | "| \(.key) | \(.value.inputTokens) | \(.value.outputTokens) | \(.value.cacheReadInputTokens) | \(.value.cacheCreationInputTokens) | $\(.value.costUSD) |"' "$JSON_TMP" 2>/dev/null
        echo ""
        echo -n "**Total cost:** \$"
        jq -r '.total_cost_usd // "n/a"' "$JSON_TMP" 2>/dev/null
    } > "$TOKEN_TMP"

    # Insert token section before ## Suggested Commit Message, or append at end
    if grep -q "^## Suggested Commit Message" "$TOKEN_TMP.result" 2>/dev/null; then
        awk -v tf="$TOKEN_TMP" '
            /^## Suggested Commit Message/ {
                while ((getline line < tf) > 0) print line
                close(tf)
                print ""
            }
            { print }
        ' "$TOKEN_TMP.result" >> "$RESULT_FILE"
    else
        cat "$TOKEN_TMP.result" >> "$RESULT_FILE"
        echo "" >> "$RESULT_FILE"
        cat "$TOKEN_TMP" >> "$RESULT_FILE"
    fi

    rm -f "$JSON_TMP" "$ERR_TMP" "$TOKEN_TMP" "$TOKEN_TMP.result"

    {
        echo ""
        echo "---"
        echo ""
        echo "**Finished:** $(date '+%Y-%m-%d %H:%M')"
    } >> "$RESULT_FILE"

    # ── Evaluation ─────────────────────────────────────────────────────────────
    EVAL_OUTPUT=$(mktemp)
    "$HOME/bin/claude-eval" "$TASK_FILE" "$RESULT_FILE" "$EVAL_OUTPUT"
    EVAL_STATUS=$?

    # Exit 3 = the evaluator itself could not authenticate. The task may well
    # have succeeded, but we cannot verify it. Defer like an auth failure:
    # requeue unchanged, no retry burned, drop the cooldown marker.
    if [ $EVAL_STATUS -eq 3 ]; then
        {
            echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
            echo ""
            echo "**Status:** DEFERRED (evaluator auth failure — not counted as retry)"
            echo "**Result:** \`$RESULT_FILE\`"
            echo ""
        } >> "$LOG"
        touch "$COOLDOWN"
        mv "$TASK_FILE" "$INBOX/${TASK_NAME}.md"
        rm -f "$EVAL_OUTPUT"
        notify-send -u critical "Claude: Auth Failure" "$TASK_NAME${WORKFLOW_LABEL} ran but could not be evaluated (auth). Deferred for re-check."
        exit 0
    fi

    # Exit 4 = a ## Test Command timed out. The task may well have succeeded; the
    # suite was just too slow/hung to yield a verdict. Defer like an auth failure
    # (requeue unchanged, no retry burned) but do NOT drop the cooldown marker —
    # this is not an auth problem and must not pause the whole queue.
    if [ $EVAL_STATUS -eq 4 ]; then
        {
            printf "\n---\n\n## Evaluator (inconclusive)\n\n"
            cat "$EVAL_OUTPUT"
        } >> "$RESULT_FILE"
        {
            echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
            echo ""
            echo "**Status:** DEFERRED (test command timed out — not counted as retry)"
            echo "**Result:** \`$RESULT_FILE\`"
            echo ""
        } >> "$LOG"
        mv "$TASK_FILE" "$INBOX/${TASK_NAME}.md"
        rm -f "$EVAL_OUTPUT"
        notify-send "Claude: Eval Timed Out" "$TASK_NAME${WORKFLOW_LABEL} verification timed out — requeued, no retry burned."
        exit 0
    fi

    if [ $EVAL_STATUS -eq 1 ]; then
        RETRIES=$(awk '/^## Retries/{found=1; next} found && /^[0-9]+$/{print; exit} found && /^##/{exit}' "$TASK_FILE" | tr -d '[:space:]')
        RETRIES=${RETRIES:-0}

        if [ "$RETRIES" -lt "$MAX_RETRIES" ]; then
            NEW_RETRIES=$((RETRIES + 1))

            # Append evaluator feedback to task file
            {
                printf "\n## Evaluator Feedback (Attempt %s)\n\n" "$NEW_RETRIES"
                cat "$EVAL_OUTPUT"
                printf "\n"
            } >> "$TASK_FILE"

            # Update or insert retry counter (no blank line between header and value)
            if grep -q "^## Retries" "$TASK_FILE"; then
                awk -v n="$NEW_RETRIES" \
                    '/^## Retries/{print; getline; print n; next} {print}' \
                    "$TASK_FILE" > "${TASK_FILE}.tmp" && mv "${TASK_FILE}.tmp" "$TASK_FILE"
            else
                printf "\n## Retries\n%s\n" "$NEW_RETRIES" >> "$TASK_FILE"
            fi

            # On retry 2+, run a strategist to diagnose the failure pattern and suggest
            # a different approach before the next attempt sees the task.
            if [ "$NEW_RETRIES" -ge 2 ]; then
                STRATEGY_TMP=$(mktemp)
                STRATEGY_ERR=$(mktemp)
                claude --dangerously-skip-permissions $MODEL_FLAG -p \
"STRATEGY MODE: This task has failed evaluation $NEW_RETRIES times. Diagnose the recurring failure pattern and suggest a concrete alternative approach for the next attempt.

Rules:
- Read the original task instructions and all ## Evaluator Feedback sections carefully.
- Identify what keeps going wrong: wrong approach, misread requirement, missing step, environment issue?
- Suggest a specific, different strategy. Name files, methods, commands, or patterns to try instead.
- Be concrete and actionable. Under 10 lines. No praise, no preamble, no closing remark.
- Output only raw Markdown starting with exactly: ## Retry Strategy (Attempt $NEW_RETRIES)

---
$(cat "$TASK_FILE")" --output-format json > "$STRATEGY_TMP" 2>"$STRATEGY_ERR"

                STRATEGY_TEXT=$(jq -r '.result // ""' "$STRATEGY_TMP" 2>/dev/null)
                rm -f "$STRATEGY_TMP" "$STRATEGY_ERR"
                if [ -n "$STRATEGY_TEXT" ]; then
                    printf '\n%s\n' "$STRATEGY_TEXT" >> "$TASK_FILE"
                fi
            fi

            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Status:** requeued (retry $NEW_RETRIES/$MAX_RETRIES)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"

            mv "$TASK_FILE" "$INBOX/${TASK_NAME}.md"
            rm -f "$EVAL_OUTPUT"
            notify-send "Claude: Task Requeued" "$TASK_NAME${WORKFLOW_LABEL} failed evaluation (retry $NEW_RETRIES/$MAX_RETRIES). Requeued."
            exit 0
        else
            # Max retries exhausted — append final feedback to result and move to review
            {
                printf "\n---\n\n## Evaluator Feedback (Final Attempt)\n\n"
                cat "$EVAL_OUTPUT"
            } >> "$RESULT_FILE"

            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Status:** NEEDS REVIEW (failed after $MAX_RETRIES retries)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"

            mv "$TASK_FILE" "$REVIEW_DIR/${TASK_NAME}.md"
            rm -f "$EVAL_OUTPUT"
            notify-send -u critical "Claude: Needs Review" "$TASK_NAME${WORKFLOW_LABEL} failed evaluation after $MAX_RETRIES retries."
            exit 1
        fi
    fi

    rm -f "$EVAL_OUTPUT"

    # Append to log
    {
        echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
        echo ""
        if [ $STATUS -eq 0 ]; then
            echo "**Status:** completed"
        else
            echo "**Status:** FAILED (exit code $STATUS)"
        fi
        echo "**Result:** \`$RESULT_FILE\`"
        echo ""
    } >> "$LOG"

    # Archive original task file alongside its result
    if [ $STATUS -eq 0 ]; then
        # Verified success: propose follow-up tasks BEFORE the task file moves to
        # done/ (the suggester still needs to read it). Best-effort — never let a
        # suggester hiccup block archival.
        generate_suggestions || true
        mv "$TASK_FILE" "$DONE_DIR/${TIMESTAMP}_${TASK_NAME}.task.md"
        if [ "${SUGGEST_COUNT:-0}" -gt 0 ]; then
            notify-send "Claude: Task Done" "$TASK_NAME${WORKFLOW_LABEL} completed. ${SUGGEST_COUNT} follow-up suggestion(s) in ~/tasks/suggestions/."
        else
            notify-send "Claude: Task Done" "$TASK_NAME${WORKFLOW_LABEL} completed successfully."
        fi
    else
        notify-send -u critical "Claude: Task Failed" "$TASK_NAME${WORKFLOW_LABEL} failed. See $RESULT_FILE"
    fi

    exit $STATUS
fi

# Returns 0 if the task has no dependency or its dependency is in done/
dep_satisfied() {
    local dep
    # Take only the first token of the Depends-on line, so a trailing
    # " (explanatory note)" is ignored. Then strip a trailing .md.
    # The value should be a bare slug (no date prefix, no .md), but the
    # leading "*_" in the glob below absorbs a date prefix if one slipped in.
    dep=$(awk '/^## Depends-on/{found=1; next} found && /^[^#]/{print $1; exit} found && /^##/{exit}' "$1")
    [ -z "$dep" ] && return 0
    dep="${dep%.md}"
    ls "$DONE_DIR"/*_"${dep}".task.md 2>/dev/null | grep -q .
}

# ── Auth cooldown guard ──────────────────────────────────────────────────────
# If a recent run hit an auth failure, pause the unattended (no-arg / cron)
# path so we don't re-fail every 15 minutes. An explicit task argument bypasses
# this — the user can manually kick a task after re-authenticating; a successful
# run clears the marker. The marker also ages out on its own.
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
CONFIG="$SCRIPT_DIR/config"
AUTH_COOLDOWN_MIN=30
[ -f "$CONFIG" ] && { source "$CONFIG"; AUTH_COOLDOWN_MIN=${auth_cooldown_min:-30}; }

if [ -z "$1" ] && [ -f "$COOLDOWN" ] && find "$COOLDOWN" -mmin -"$AUTH_COOLDOWN_MIN" 2>/dev/null | grep -q .; then
    echo "Auth cooldown active (last auth failure < ${AUTH_COOLDOWN_MIN}m ago). Skipping."
    echo "Re-authenticate (e.g. /login), then run a task manually or 'rm $COOLDOWN' to resume now."
    exit 0
fi

# ── Launcher mode ──────────────────────────────────────────────────────────
if [ -n "$1" ]; then
    TASK_FILE="$1"
    if ! dep_satisfied "$TASK_FILE"; then
        DEP=$(awk '/^## Depends-on/{found=1; next} found && /^[^#]/{print $1; exit} found && /^##/{exit}' "$TASK_FILE")
        echo "Task blocked: depends on '${DEP%.md}' which is not yet in done/."
        exit 1
    fi
else
    TASK_FILE=""
    for f in $(ls -tr "$INBOX"/*.md 2>/dev/null); do
        dep_satisfied "$f" && { TASK_FILE="$f"; break; }
    done
fi

if [ -z "$TASK_FILE" ]; then
    if ls "$INBOX"/*.md 2>/dev/null | grep -q .; then
        # Every remaining task is blocked. Flag any whose dependency has landed in
        # review/ (failed) — those are DEAD: they can never unblock on their own and
        # will pile up silently. Surface them so the user can intervene.
        BLOCKED_COUNT=$(ls "$INBOX"/*.md 2>/dev/null | wc -l)
        DEAD=""
        for f in "$INBOX"/*.md; do
            [ -f "$f" ] || continue
            d=$(awk '/^## Depends-on/{found=1; next} found && /^[^#]/{print $1; exit} found && /^##/{exit}' "$f")
            d="${d%.md}"
            [ -z "$d" ] && continue
            if ls "$REVIEW_DIR"/*"${d}"*.md >/dev/null 2>&1; then
                DEAD="${DEAD}\n  - $(basename "$f" .md) → dep '${d}' is in review/ (failed)"
            fi
        done
        echo "All $BLOCKED_COUNT task(s) in $INBOX are blocked by unmet dependencies."
        if [ -n "$DEAD" ]; then
            echo -e "Dead dependency chains (dependency failed to review/):$DEAD"
            notify-send -u critical "Claude: Tasks Permanently Blocked" \
                "One or more inbox tasks depend on a task that failed to review/. They will never run until you intervene."
        fi
    else
        echo "Usage: claude-task [task.md]"
        echo "No .md task file found in $INBOX"
    fi
    exit 1
fi

if [ ! -f "$TASK_FILE" ]; then
    echo "Task file not found: $TASK_FILE"
    exit 1
fi

TASK_NAME=$(basename "$TASK_FILE" .md)
SESSION="claude-${TASK_NAME}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Session '$SESSION' already running. Attach: tmux attach -t $SESSION"
    exit 1
fi

mkdir -p "$RUN_DIR"
mv "$TASK_FILE" "$RUN_DIR/"
TASK_FILE="$RUN_DIR/$(basename "$TASK_FILE")"

tmux new-session -d -s "$SESSION" bash -lc "\"$HOME/bin/claude-task\" --run \"$TASK_FILE\""

echo "Task '$TASK_NAME' started in tmux session '$SESSION'."
echo "Monitor : tmux attach -t $SESSION"
echo "Result  : $DONE_DIR/*_${TASK_NAME}.md"
