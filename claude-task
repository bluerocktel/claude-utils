#!/bin/bash
# claude-task: run a Claude task autonomously in a detached tmux session
#
# Usage:
#   claude-task [task.md]     Launch task (picks oldest from ~/tasks/inbox/ if no arg)
#   claude-task --run FILE    Internal mode used by tmux (do not call directly)

INBOX=~/tasks/inbox
RUN_DIR=~/tasks/run
DONE_DIR=~/tasks/done
REVIEW_DIR=~/tasks/review
LOG=~/tasks/DONE.md

# ── Internal execution mode ────────────────────────────────────────────────
if [ "$1" = "--run" ]; then
    TASK_FILE="$2"
    TASK_NAME=$(basename "$TASK_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
    RESULT_FILE="$DONE_DIR/${TIMESTAMP}_${TASK_NAME}.md"

    # Source config for MAX_RETRIES (default 3); set max_retries=N in config to override
    SCRIPT_DIR="$(dirname "$(realpath "$0")")"
    CONFIG="$SCRIPT_DIR/config"
    MAX_RETRIES=3
    [ -f "$CONFIG" ] && { source "$CONFIG"; MAX_RETRIES=${max_retries:-3}; }
    mkdir -p "$REVIEW_DIR"

    {
        echo "# $TASK_NAME"
        echo ""
        echo "**Started:** $(date '+%Y-%m-%d %H:%M')"
        echo ""
        echo "---"
        echo ""
    } > "$RESULT_FILE"

    PREAMBLE="AUTONOMOUS MODE: You have no user to interact with. Never ask questions, never present options, never wait for confirmation. Make decisions and implement immediately. Document choices in a ## Summary at the end. After the ## Summary, always add a ## Tools Used section listing: (1) Agents: any agents from ~/.claude/agents/ that were invoked (list by name, or 'none'); (2) Skills: any skills that were invoked (list by name, or 'none'). After ## Tools Used, add a ## Suggested Commit Message section containing a ready-to-use git commit message (subject line + optional body) that accurately describes all changes made. Do not run git commit yourself."

    # Resolve optional model override from task frontmatter (## Model field)
    MODEL_FLAG=""
    RAW_MODEL=$(awk '/^## Model/{found=1; next} found && /^[^#]/{print; exit}' "$TASK_FILE" | tr -d '[:space:]')
    case "$RAW_MODEL" in
        opus)   MODEL_FLAG="--model claude-opus-4-6" ;;
        sonnet) MODEL_FLAG="--model claude-sonnet-4-6" ;;
        haiku)  MODEL_FLAG="--model claude-haiku-4-5-20251001" ;;
        "")     MODEL_FLAG="" ;;
        *)      MODEL_FLAG="--model $RAW_MODEL" ;;
    esac

    JSON_TMP=$(mktemp)
    TOKEN_TMP=$(mktemp)

    # --output-format json captures usage stats; no live streaming to RESULT_FILE during execution
    claude --dangerously-skip-permissions $MODEL_FLAG -p "$PREAMBLE

$(cat "$TASK_FILE")" --output-format json > "$JSON_TMP" 2>&1
    STATUS=$?

    # Write Claude's response text to the result file
    jq -r '.result // ""' "$JSON_TMP" > "$TOKEN_TMP.result" 2>/dev/null

    # Build token usage section
    {
        echo "## Token Usage"
        echo ""
        echo "| Model | Input | Output | Cache Read | Cache Write | Cost |"
        echo "|-------|-------|--------|------------|-------------|------|"
        jq -r '.modelUsage | to_entries[] | "| \(.key) | \(.value.inputTokens) | \(.value.outputTokens) | \(.value.cacheReadInputTokens) | \(.value.cacheCreationInputTokens) | $\(.value.costUSD) |"' "$JSON_TMP" 2>/dev/null
        echo ""
        echo -n "**Total cost:** \$"
        jq -r '.total_cost_usd // "n/a"' "$JSON_TMP" 2>/dev/null
    } > "$TOKEN_TMP"

    # Insert token section before ## Suggested Commit Message, or append at end
    if grep -q "^## Suggested Commit Message" "$TOKEN_TMP.result" 2>/dev/null; then
        awk -v tf="$TOKEN_TMP" '
            /^## Suggested Commit Message/ {
                while ((getline line < tf) > 0) print line
                close(tf)
                print ""
            }
            { print }
        ' "$TOKEN_TMP.result" >> "$RESULT_FILE"
    else
        cat "$TOKEN_TMP.result" >> "$RESULT_FILE"
        echo "" >> "$RESULT_FILE"
        cat "$TOKEN_TMP" >> "$RESULT_FILE"
    fi

    rm -f "$JSON_TMP" "$TOKEN_TMP" "$TOKEN_TMP.result"

    {
        echo ""
        echo "---"
        echo ""
        echo "**Finished:** $(date '+%Y-%m-%d %H:%M')"
    } >> "$RESULT_FILE"

    # ── Evaluation ─────────────────────────────────────────────────────────────
    EVAL_OUTPUT=$(mktemp)
    "$HOME/bin/claude-eval" "$TASK_FILE" "$RESULT_FILE" "$EVAL_OUTPUT"
    EVAL_STATUS=$?

    if [ $EVAL_STATUS -eq 1 ]; then
        RETRIES=$(awk '/^## Retries/{found=1; next} found && /^[0-9]+$/{print; exit} found && /^##/{exit}' "$TASK_FILE" | tr -d '[:space:]')
        RETRIES=${RETRIES:-0}

        if [ "$RETRIES" -lt "$MAX_RETRIES" ]; then
            NEW_RETRIES=$((RETRIES + 1))

            # Append evaluator feedback to task file
            {
                printf "\n## Evaluator Feedback (Attempt %s)\n\n" "$NEW_RETRIES"
                cat "$EVAL_OUTPUT"
                printf "\n"
            } >> "$TASK_FILE"

            # Update or insert retry counter (no blank line between header and value)
            if grep -q "^## Retries" "$TASK_FILE"; then
                awk -v n="$NEW_RETRIES" \
                    '/^## Retries/{print; getline; print n; next} {print}' \
                    "$TASK_FILE" > "${TASK_FILE}.tmp" && mv "${TASK_FILE}.tmp" "$TASK_FILE"
            else
                printf "\n## Retries\n%s\n" "$NEW_RETRIES" >> "$TASK_FILE"
            fi

            # On retry 2+, run a strategist to diagnose the failure pattern and suggest
            # a different approach before the next attempt sees the task.
            if [ "$NEW_RETRIES" -ge 2 ]; then
                STRATEGY_TMP=$(mktemp)
                claude --dangerously-skip-permissions $MODEL_FLAG -p \
"STRATEGY MODE: This task has failed evaluation $NEW_RETRIES times. Diagnose the recurring failure pattern and suggest a concrete alternative approach for the next attempt.

Rules:
- Read the original task instructions and all ## Evaluator Feedback sections carefully.
- Identify what keeps going wrong: wrong approach, misread requirement, missing step, environment issue?
- Suggest a specific, different strategy. Name files, methods, commands, or patterns to try instead.
- Be concrete and actionable. Under 10 lines. No praise, no preamble, no closing remark.
- Output only raw Markdown starting with exactly: ## Retry Strategy (Attempt $NEW_RETRIES)

---
$(cat "$TASK_FILE")" --output-format json > "$STRATEGY_TMP" 2>&1

                STRATEGY_TEXT=$(jq -r '.result // ""' "$STRATEGY_TMP" 2>/dev/null)
                rm -f "$STRATEGY_TMP"
                if [ -n "$STRATEGY_TEXT" ]; then
                    printf '\n%s\n' "$STRATEGY_TEXT" >> "$TASK_FILE"
                fi
            fi

            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Status:** requeued (retry $NEW_RETRIES/$MAX_RETRIES)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"

            mv "$TASK_FILE" "$INBOX/${TASK_NAME}.md"
            rm -f "$EVAL_OUTPUT"
            notify-send "Claude: Task Requeued" "$TASK_NAME failed evaluation (retry $NEW_RETRIES/$MAX_RETRIES). Requeued."
            exit 0
        else
            # Max retries exhausted — append final feedback to result and move to review
            {
                printf "\n---\n\n## Evaluator Feedback (Final Attempt)\n\n"
                cat "$EVAL_OUTPUT"
            } >> "$RESULT_FILE"

            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Status:** NEEDS REVIEW (failed after $MAX_RETRIES retries)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"

            mv "$TASK_FILE" "$REVIEW_DIR/${TASK_NAME}.md"
            rm -f "$EVAL_OUTPUT"
            notify-send -u critical "Claude: Needs Review" "$TASK_NAME failed evaluation after $MAX_RETRIES retries."
            exit 1
        fi
    fi

    rm -f "$EVAL_OUTPUT"

    # Append to log
    {
        echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
        echo ""
        if [ $STATUS -eq 0 ]; then
            echo "**Status:** completed"
        else
            echo "**Status:** FAILED (exit code $STATUS)"
        fi
        echo "**Result:** \`$RESULT_FILE\`"
        echo ""
    } >> "$LOG"

    # Archive original task file alongside its result
    if [ $STATUS -eq 0 ]; then
        mv "$TASK_FILE" "$DONE_DIR/${TIMESTAMP}_${TASK_NAME}.task.md"
        notify-send "Claude: Task Done" "$TASK_NAME completed successfully."
    else
        notify-send -u critical "Claude: Task Failed" "$TASK_NAME failed. See $RESULT_FILE"
    fi

    exit $STATUS
fi

# Returns 0 if the task has no dependency or its dependency is in done/
dep_satisfied() {
    local dep
    dep=$(awk '/^## Depends-on/{found=1; next} found && /^[^#]/{print; exit} found && /^##/{exit}' "$1" | tr -d '[:space:]')
    [ -z "$dep" ] && return 0
    dep="${dep%.md}"
    ls "$DONE_DIR"/*_"${dep}".task.md 2>/dev/null | grep -q .
}

# ── Launcher mode ──────────────────────────────────────────────────────────
if [ -n "$1" ]; then
    TASK_FILE="$1"
    if ! dep_satisfied "$TASK_FILE"; then
        DEP=$(awk '/^## Depends-on/{found=1; next} found && /^[^#]/{print; exit} found && /^##/{exit}' "$TASK_FILE" | tr -d '[:space:]')
        echo "Task blocked: depends on '${DEP%.md}' which is not yet in done/."
        exit 1
    fi
else
    TASK_FILE=""
    for f in $(ls -tr "$INBOX"/*.md 2>/dev/null); do
        dep_satisfied "$f" && { TASK_FILE="$f"; break; }
    done
fi

if [ -z "$TASK_FILE" ]; then
    if ls "$INBOX"/*.md 2>/dev/null | grep -q .; then
        echo "All tasks in $INBOX are blocked by unmet dependencies."
    else
        echo "Usage: claude-task [task.md]"
        echo "No .md task file found in $INBOX"
    fi
    exit 1
fi

if [ ! -f "$TASK_FILE" ]; then
    echo "Task file not found: $TASK_FILE"
    exit 1
fi

TASK_NAME=$(basename "$TASK_FILE" .md)
SESSION="claude-${TASK_NAME}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Session '$SESSION' already running. Attach: tmux attach -t $SESSION"
    exit 1
fi

mkdir -p "$RUN_DIR"
mv "$TASK_FILE" "$RUN_DIR/"
TASK_FILE="$RUN_DIR/$(basename "$TASK_FILE")"

tmux new-session -d -s "$SESSION" bash -lc "\"$HOME/bin/claude-task\" --run \"$TASK_FILE\""

echo "Task '$TASK_NAME' started in tmux session '$SESSION'."
echo "Monitor : tmux attach -t $SESSION"
echo "Result  : $DONE_DIR/*_${TASK_NAME}.md"
