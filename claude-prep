#!/bin/bash
# claude-prep: prepare a backlog task by adding acceptance criteria and structure
#
# Usage:
#   claude-prep [task.md]     Prepare task (picks oldest from ~/tasks/backlog/ if no arg)
#   claude-prep --run FILE    Internal mode used by tmux (do not call directly)

BACKLOG_DIR=~/tasks/backlog
RUN_DIR=~/tasks/run
REVIEW_DIR=~/tasks/backlog-for-review

# ── Internal execution mode ────────────────────────────────────────────────
if [ "$1" = "--run" ]; then
    TASK_FILE="$2"
    TASK_NAME=$(basename "$TASK_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
    TODAY=$(date '+%Y-%m-%d')
    RESULT_FILE="$REVIEW_DIR/${TIMESTAMP}_${TASK_NAME}.md"

    touch "$RESULT_FILE"
    tail -f "$RESULT_FILE" &
    TAIL_PID=$!

    PREAMBLE="TASK PREPARATION MODE: You are preparing a rough task idea into a well-structured task file ready for execution. Do not write code, edit files, or run shell commands.

Read the rough task description and produce a complete Markdown task file with:
- ## Project: preserve if present in the original, otherwise omit.
- ## Context: restate the goal clearly, add any relevant background.
- ## Tasks: concrete numbered instructions for autonomous execution. Be precise about what to do.
- ## Expected outcome: what success looks like.
- ## Acceptance Criteria: specific, verifiable pass/fail items that an evaluator can check.

Keep the original intent. Add structure and clarity, not scope.

TASK SIZE RULE: Each task must be completable in a single focused session without hitting context limits. If the task touches more than 5 files, spans more than 3 distinct logical phases, or involves generating large volumes of content, it is too large — split it into multiple smaller tasks connected with ## Depends-on (the value is the slug of the prior task, no date prefix, no .md extension). Prefer more tasks over larger tasks.

OUTPUT FORMAT — choose based on whether splitting is needed:

Single task (fits the size rule): output raw Markdown starting directly with the first ## heading. No code fences, no preamble, no commentary.

Split tasks (task is too large): output each sub-task using EXACTLY this delimiter format:
===TASK_FILE_BEGIN: ${TODAY}_SLUG.md===
(task content starting with the first ## heading)
===TASK_FILE_END===
Replace SLUG with a short lowercase description specific to that sub-task. Connect dependent tasks with ## Depends-on (slug only, no date prefix, no .md).

In both cases: no introductory sentence, no closing remarks, no code fences around the delimiters themselves."

    claude --dangerously-skip-permissions -p "$PREAMBLE

$(cat "$TASK_FILE")" > "$RESULT_FILE" 2>&1
    STATUS=$?

    # Post-process: handle single-task or split-task output
    N_FILES=0
    SPLIT=0
    if grep -q "^===TASK_FILE_BEGIN: " "$RESULT_FILE"; then
        SPLIT=1
        N_FILES=$(awk -v dir="$REVIEW_DIR" '
            /^===TASK_FILE_BEGIN: / {
                sub(/^===TASK_FILE_BEGIN: /, "")
                sub(/===[ \t]*$/, "")
                filename = $0
                in_file = 1
                buffer = ""
                next
            }
            /^===TASK_FILE_END===/ {
                in_file = 0
                print buffer > (dir "/" filename)
                close(dir "/" filename)
                n++
                next
            }
            in_file {
                buffer = (buffer ? buffer "\n" $0 : $0)
            }
            END { print (n ? n : 0) }
        ' "$RESULT_FILE")
        rm -f "$RESULT_FILE"
    else
        # Single task: strip any leading commentary / code-fence wrapper
        awk '
            /^## / { found=1 }
            found { lines[n++] = $0 }
            END {
                if (n > 0 && lines[n-1] ~ /^```[[:space:]]*$/) n--
                for (i=0; i<n; i++) print lines[i]
            }
        ' "$RESULT_FILE" > "${RESULT_FILE}.tmp" && mv "${RESULT_FILE}.tmp" "$RESULT_FILE"
    fi

    kill $TAIL_PID 2>/dev/null
    wait $TAIL_PID 2>/dev/null

    SUCCESS=0
    if [ $STATUS -eq 0 ]; then
        if [ "$SPLIT" -eq 1 ] && [ "$N_FILES" -gt 0 ]; then SUCCESS=1
        elif [ "$SPLIT" -eq 0 ] && [ -s "$RESULT_FILE" ]; then SUCCESS=1
        fi
    fi

    if [ "$SUCCESS" -eq 1 ]; then
        mv "$TASK_FILE" "$BACKLOG_DIR/$(basename "$TASK_FILE" .md)"
        if [ "$SPLIT" -eq 1 ]; then
            notify-send "Claude: Task Split" "$TASK_NAME → $N_FILES tasks in backlog-for-review/"
        else
            notify-send "Claude: Task Prepared" "$TASK_NAME. Review in ~/tasks/backlog-for-review/"
        fi
    else
        notify-send -u critical "Claude: Prep Failed" "$TASK_NAME preparation failed. See $RESULT_FILE"
        mv "$TASK_FILE" "$BACKLOG_DIR/$(basename "$TASK_FILE")"
        rm -f "$RESULT_FILE"
        exit 1
    fi

    exit $STATUS
fi

# ── Launcher mode ──────────────────────────────────────────────────────────
if [ -n "$1" ]; then
    TASK_FILE="$1"
else
    TASK_FILE=$(ls -tr "$BACKLOG_DIR"/*.md 2>/dev/null | head -1)
fi

if [ -z "$TASK_FILE" ] || [ ! -f "$TASK_FILE" ]; then
    echo "Usage: claude-prep [task.md]"
    echo "No .md task file found in $BACKLOG_DIR"
    exit 1
fi

TASK_NAME=$(basename "$TASK_FILE" .md)
SESSION="claude-prep-${TASK_NAME}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Session '$SESSION' already running. Attach: tmux attach -t $SESSION"
    exit 1
fi

mkdir -p "$RUN_DIR"
mv "$TASK_FILE" "$RUN_DIR/"
TASK_FILE="$RUN_DIR/$(basename "$TASK_FILE")"

tmux new-session -d -s "$SESSION" bash -lc "\"$HOME/bin/claude-prep\" --run \"$TASK_FILE\""

echo "Preparing '$TASK_NAME' started in tmux session '$SESSION'."
echo "Monitor : tmux attach -t $SESSION"
echo "Result  : $REVIEW_DIR/*_${TASK_NAME}.md"
