#!/bin/bash
# claude-prep: prepare a backlog task by adding acceptance criteria and structure
#
# Usage:
#   claude-prep [task.md]     Prepare task (picks oldest from ~/tasks/backlog/ if no arg)
#   claude-prep --run FILE    Internal mode used by tmux (do not call directly)

BACKLOG_DIR=~/tasks/backlog
RUN_DIR=~/tasks/run
REVIEW_DIR=~/tasks/backlog-for-review

# ── Internal execution mode ────────────────────────────────────────────────
if [ "$1" = "--run" ]; then
    TASK_FILE="$2"
    TASK_NAME=$(basename "$TASK_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
    RESULT_FILE="$REVIEW_DIR/${TIMESTAMP}_${TASK_NAME}.md"

    touch "$RESULT_FILE"
    tail -f "$RESULT_FILE" &
    TAIL_PID=$!

    PREAMBLE="TASK PREPARATION MODE: You are preparing a rough task idea into a well-structured task file ready for execution. Do not write code, edit files, or run shell commands.

Read the rough task description and produce a complete Markdown task file with:
- ## Project: preserve if present in the original, otherwise omit.
- ## Context: restate the goal clearly, add any relevant background.
- ## Tasks: concrete numbered instructions for autonomous execution. Be precise about what to do.
- ## Expected outcome: what success looks like.
- ## Acceptance Criteria: specific, verifiable pass/fail items that an evaluator can check.

Keep the original intent. Add structure and clarity, not scope. Output only the task file content, no commentary."

    claude --dangerously-skip-permissions -p "$PREAMBLE

$(cat "$TASK_FILE")" > "$RESULT_FILE" 2>&1
    STATUS=$?

    kill $TAIL_PID 2>/dev/null
    wait $TAIL_PID 2>/dev/null

    if [ $STATUS -eq 0 ] && [ -s "$RESULT_FILE" ]; then
        # Archive original (without .md) so it won't be picked up again
        mv "$TASK_FILE" "$BACKLOG_DIR/$(basename "$TASK_FILE" .md)"
        notify-send "Claude: Task Prepared" "$TASK_NAME. Review in ~/tasks/backlog-for-review/"
    else
        notify-send -u critical "Claude: Prep Failed" "$TASK_NAME preparation failed. See $RESULT_FILE"
        # Move original back to backlog so it can be retried
        mv "$TASK_FILE" "$BACKLOG_DIR/$(basename "$TASK_FILE")"
        rm -f "$RESULT_FILE"
        exit 1
    fi

    exit $STATUS
fi

# ── Launcher mode ──────────────────────────────────────────────────────────
if [ -n "$1" ]; then
    TASK_FILE="$1"
else
    TASK_FILE=$(ls -tr "$BACKLOG_DIR"/*.md 2>/dev/null | head -1)
fi

if [ -z "$TASK_FILE" ] || [ ! -f "$TASK_FILE" ]; then
    echo "Usage: claude-prep [task.md]"
    echo "No .md task file found in $BACKLOG_DIR"
    exit 1
fi

TASK_NAME=$(basename "$TASK_FILE" .md)
SESSION="claude-prep-${TASK_NAME}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Session '$SESSION' already running. Attach: tmux attach -t $SESSION"
    exit 1
fi

mkdir -p "$RUN_DIR"
mv "$TASK_FILE" "$RUN_DIR/"
TASK_FILE="$RUN_DIR/$(basename "$TASK_FILE")"

tmux new-session -d -s "$SESSION" bash -lc "\"$HOME/bin/claude-prep\" --run \"$TASK_FILE\""

echo "Preparing '$TASK_NAME' started in tmux session '$SESSION'."
echo "Monitor : tmux attach -t $SESSION"
echo "Result  : $REVIEW_DIR/*_${TASK_NAME}.md"
