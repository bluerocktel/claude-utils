#!/bin/bash
# claude-eval: evaluate a completed task against its acceptance criteria
#
# Usage:
#   claude-eval TASK_FILE RESULT_FILE [OUTPUT_FILE]
#
# Exit codes:
#   0 = PASS
#   1 = FAIL
#   2 = no ## Acceptance Criteria section found (skip evaluation)
#   3 = inconclusive: the evaluator call itself failed to authenticate
#       (auth/environment failure, NOT a task-quality failure). Callers must
#       not treat this as a FAIL or burn a retry on it.
#   4 = inconclusive: a ## Test Command timed out (slow/hung suite, often
#       concurrency-induced — NOT a task-quality failure and NOT auth). Callers
#       must defer without burning a retry, but must NOT pause the queue.
#
# If OUTPUT_FILE is given, evaluator response is written there.
# Otherwise it is printed to stdout.

# Signature of an auth/credentials failure (expired token, 401). Matches the
# text Claude emits to stdout/stderr when it cannot authenticate.
is_auth_failure() {
    grep -qiE 'API Error: 401|Invalid authentication credentials|OAuth token (has )?expired|Failed to authenticate' "$1"
}

TASK_FILE="$1"
RESULT_FILE="$2"
OUTPUT_FILE="$3"

if [ -z "$TASK_FILE" ] || [ -z "$RESULT_FILE" ]; then
    echo "Usage: claude-eval TASK_FILE RESULT_FILE [OUTPUT_FILE]" >&2
    exit 2
fi

if [ ! -f "$TASK_FILE" ]; then
    echo "claude-eval: task file not found: $TASK_FILE" >&2
    exit 2
fi

if [ ! -f "$RESULT_FILE" ]; then
    echo "claude-eval: result file not found: $RESULT_FILE" >&2
    exit 2
fi

# Config: TEST_TIMEOUT_MIN caps each ## Test Command so a slow/hung suite can't
# stall the evaluator indefinitely (set test_timeout_min=N in config to override).
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
CONFIG="$SCRIPT_DIR/config"
TEST_TIMEOUT_MIN=20
[ -f "$CONFIG" ] && { source "$CONFIG"; TEST_TIMEOUT_MIN=${test_timeout_min:-20}; }

# ── Test Command ───────────────────────────────────────────────────────────
# Run commands under ## Test Command before calling the LLM evaluator.
# A non-zero exit from any command short-circuits to FAIL immediately.
TEST_PASSED=0
if grep -q "^## Test Command" "$TASK_FILE"; then
    TEST_TMP=$(mktemp)
    TEST_EXIT=0
    TEST_RAN=0
    TEST_FAILED_CMD=""

    ACC=""
    while IFS= read -r line; do
        # Skip Markdown code-fence delimiter lines (``` or ~~~), which the awk
        # below captures alongside the commands when the Test Command is written
        # as a fenced block. A bare fence line is not a runnable command —
        # feeding it to bash -c aborts with "unexpected EOF while looking for
        # matching" and masquerades as a genuine test failure.
        case "$line" in '```'*|'~~~'*) continue ;; esac
        # Honour backslash line-continuation exactly as bash does: strip the
        # trailing backslash, accumulate, and defer execution until the logical
        # command is complete. Without this, a multi-line "cmd && \" Test Command
        # runs each physical line separately and the dangling "\" fails.
        if [ "${line%\\}" != "$line" ]; then
            ACC="$ACC${line%\\}"
            continue
        fi
        cmd="$ACC$line"
        ACC=""
        [ -z "${cmd// }" ] && continue
        TEST_RAN=1
        timeout "$((TEST_TIMEOUT_MIN * 60))" bash -c "$cmd" >> "$TEST_TMP" 2>&1
        CMD_EXIT=$?
        # A timeout (124) is NOT a task-quality signal — the suite may pass but be
        # slow (or hung by concurrency). Return inconclusive (3) so the caller
        # defers instead of failing the task and burning a retry.
        if [ $CMD_EXIT -eq 124 ]; then
            TIMEOUT_MSG=$(printf '## Test Results\n\nCommand timed out after %sm (verdict inconclusive):\n```\n%s\n```\n\nPartial output:\n```\n%s\n```' \
                "$TEST_TIMEOUT_MIN" "$cmd" "$(cat "$TEST_TMP")")
            if [ -n "$OUTPUT_FILE" ]; then
                printf '%s\n' "$TIMEOUT_MSG" > "$OUTPUT_FILE"
            else
                printf '%s\n' "$TIMEOUT_MSG"
            fi
            rm -f "$TEST_TMP"
            exit 4
        fi
        if [ $CMD_EXIT -ne 0 ]; then
            TEST_EXIT=$CMD_EXIT
            TEST_FAILED_CMD="$cmd"
            break
        fi
    done < <(awk '/^## Test Command/{found=1; next} found && /^## /{exit} found{print}' "$TASK_FILE")

    # Flush a trailing unterminated continuation (a block whose last line ended
    # with a "\"); normal blocks end without one, so this is just a safety net.
    if [ $TEST_EXIT -eq 0 ] && [ -n "${ACC// }" ]; then
        TEST_RAN=1
        timeout "$((TEST_TIMEOUT_MIN * 60))" bash -c "$ACC" >> "$TEST_TMP" 2>&1
        CMD_EXIT=$?
        if [ $CMD_EXIT -ne 0 ]; then
            TEST_EXIT=$CMD_EXIT
            TEST_FAILED_CMD="$ACC"
        fi
    fi

    if [ $TEST_EXIT -ne 0 ]; then
        FAIL_MSG=$(printf '## Test Results\n\nCommand failed (exit %s):\n```\n%s\n```\n\nOutput:\n```\n%s\n```\n\nVERDICT: FAIL' \
            "$TEST_EXIT" "$TEST_FAILED_CMD" "$(cat "$TEST_TMP")")
        if [ -n "$OUTPUT_FILE" ]; then
            printf '%s\n' "$FAIL_MSG" > "$OUTPUT_FILE"
        else
            printf '%s\n' "$FAIL_MSG"
        fi
        rm -f "$TEST_TMP"
        exit 1
    fi
    rm -f "$TEST_TMP"
    [ $TEST_RAN -eq 1 ] && TEST_PASSED=1
fi

# Exit early if no acceptance criteria
if ! grep -q "^## Acceptance Criteria" "$TASK_FILE"; then
    # If tests ran and passed, that counts as PASS; otherwise skip evaluation
    exit $((TEST_PASSED == 1 ? 0 : 2))
fi

# Resolve model from task frontmatter (## Model field), same logic as claude-task
MODEL_FLAG=""
RAW_MODEL=$(awk '/^## Model/{found=1; next} found && /^[^#]/{print; exit}' "$TASK_FILE" | tr -d '[:space:]')
case "$RAW_MODEL" in
    opus)   MODEL_FLAG="--model claude-opus-4-8" ;;
    sonnet) MODEL_FLAG="--model claude-sonnet-5" ;;
    haiku)  MODEL_FLAG="--model claude-haiku-4-5-20251001" ;;
    fable)  MODEL_FLAG="--model claude-fable-5" ;;
    "")     MODEL_FLAG="" ;;
    *)      MODEL_FLAG="--model $RAW_MODEL" ;;
esac

PROMPT_TMP=$(mktemp)
JSON_TMP=$(mktemp)
ERR_TMP=$(mktemp)

{
    cat <<'PREAMBLE'
You are a skeptical evaluator reviewing the output of an autonomous agent. Assess whether the task was completed correctly against its acceptance criteria.

Rules:
- Be critical. Do not give the benefit of the doubt.
- If a criterion cannot be verified from the result, mark it FAIL.
- Do not praise — only report problems.

Output format:
1. Grade each acceptance criterion as: "- [PASS/FAIL] criterion: one-line reason"
2. A "## Issues" section listing specific problems to fix (omit section entirely if all PASS).
3. End your response with exactly one of these two lines:
   VERDICT: PASS
   VERDICT: FAIL

---
## TASK

PREAMBLE
    cat "$TASK_FILE"
    printf "\n---\n## RESULT\n\n"
    cat "$RESULT_FILE"
} > "$PROMPT_TMP"

# stderr MUST stay out of the JSON: merging it (2>&1) prepends warnings such as
# the "workspace has not been trusted" notice, which breaks jq and silently
# empties the verdict — that empty verdict used to be mis-read as FAIL and burn
# retries. Capture stderr separately; auth detection scans both streams.
claude --dangerously-skip-permissions $MODEL_FLAG \
    -p "$(cat "$PROMPT_TMP")" \
    --output-format json > "$JSON_TMP" 2>"$ERR_TMP"
CLAUDE_STATUS=$?

EVAL_TEXT=$(jq -r '.result // ""' "$JSON_TMP" 2>/dev/null)

if [ -n "$OUTPUT_FILE" ]; then
    printf '%s\n' "$EVAL_TEXT" > "$OUTPUT_FILE"
else
    printf '%s\n' "$EVAL_TEXT"
fi

# Inconclusive (3) cases — the verdict is meaningless, so the caller must defer
# instead of failing the task or burning a retry:
#   - the evaluator could not authenticate, or
#   - we got no parseable verdict text at all (empty result). This last guard is
#     what stops an unparseable/garbled evaluator output from masquerading as a
#     genuine FAIL, which is exactly the bug that sent a passing task to review.
if is_auth_failure "$JSON_TMP" || is_auth_failure "$ERR_TMP" || [ -z "$EVAL_TEXT" ]; then
    rm -f "$PROMPT_TMP" "$JSON_TMP" "$ERR_TMP"
    exit 3
fi

rm -f "$PROMPT_TMP" "$JSON_TMP" "$ERR_TMP"

if [ $CLAUDE_STATUS -ne 0 ]; then
    exit 1
fi

if printf '%s\n' "$EVAL_TEXT" | grep -q "^VERDICT: PASS$"; then
    exit 0
else
    exit 1
fi
