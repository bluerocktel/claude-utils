#!/bin/bash
# dtask: dashboard view of all claude task pipeline stages
#
# Usage:
#   dtask                  Show dashboard once
#   watch -n 30 dtask      Live refresh every 30 seconds

TASKS=~/tasks
DRAFTS=$TASKS/drafts
BACKLOG=$TASKS/backlog
BACKLOG_REVIEW=$TASKS/backlog-for-review
PLAN=$TASKS/plan
PLAN_REVIEW=$TASKS/plan-for-review
INBOX=$TASKS/inbox
RUN=$TASKS/run
REVIEW=$TASKS/review
LOG=$TASKS/DONE.md

# ── Colors ──────────────────────────────────────────────────────
if [ "${NO_COLOR:-}" ]; then
    BOLD="" RED="" GREEN="" YELLOW="" BLUE="" CYAN="" DIM="" RESET=""
else
    BOLD=$(tput bold 2>/dev/null || echo "")
    RED=$(tput setaf 1 2>/dev/null || echo "")
    GREEN=$(tput setaf 2 2>/dev/null || echo "")
    YELLOW=$(tput setaf 3 2>/dev/null || echo "")
    BLUE=$(tput setaf 4 2>/dev/null || echo "")
    CYAN=$(tput setaf 6 2>/dev/null || echo "")
    DIM=$(tput dim 2>/dev/null || tput setaf 8 2>/dev/null || echo "")
    RESET=$(tput sgr0 2>/dev/null || echo "")
fi

# ── Helpers ─────────────────────────────────────────────────────

# Count regular files in a directory
_count() {
    local dir="$1"
    [ -d "$dir" ] || { echo 0; return; }
    find "$dir" -maxdepth 1 -type f | wc -l
}

# List basenames (strip .md) of files in a directory
_list() {
    local dir="$1"
    [ -d "$dir" ] || return
    find "$dir" -maxdepth 1 -type f -printf "%f\n" | sed 's/\.md$//' | sort
}

# Read ## Project field from a task file
_get_project() {
    local file="$1"
    awk '/^## Project/{found=1; next} found && /^[^#[:space:]]/{print; exit} found && /^[[:space:]]*$/{next} found && /^##/{exit}' "$file" 2>/dev/null | tr -d '[:space:]'
}

# Elapsed time from file mtime
_elapsed() {
    local file="$1"
    local now mtime diff
    now=$(date +%s)
    mtime=$(stat -c %Y "$file" 2>/dev/null || echo "$now")
    diff=$((now - mtime))
    if   [ $diff -lt 60 ];   then echo "${diff}s"
    elif [ $diff -lt 3600 ]; then echo "$((diff/60))m"
    else echo "$((diff/3600))h$((diff%3600/60))m"
    fi
}

# Print a section header
_section() {
    printf '\n%s%s%s\n' "${BOLD}${CYAN}" "$1" "$RESET"
}

# Print a separator line
_sep() {
    printf '%s%s%s\n' "$DIM" "────────────────────────────────────────────────────────────" "$RESET"
}

# Format a pipeline stage: dimmed if 0, yellow if warn+count>0, else normal
_stage() {
    local label="$1" count="$2" warn="${3:-}"
    if [ "$count" -eq 0 ]; then
        printf '%s%s(%d)%s' "$DIM" "$label" "$count" "$RESET"
    elif [ -n "$warn" ]; then
        printf '%s%s%s(%s%d%s)' "$BOLD" "$label" "$RESET" "${YELLOW}" "$count" "$RESET"
    else
        printf '%s%s%s(%d)' "$BOLD" "$label" "$RESET" "$count"
    fi
}

# ── Counts ──────────────────────────────────────────────────────
n_drafts=$(_count "$DRAFTS")
n_backlog=$(_count "$BACKLOG")
n_brev=$(_count "$BACKLOG_REVIEW")
n_plan=$(_count "$PLAN")
n_prev=$(_count "$PLAN_REVIEW")
n_inbox=$(_count "$INBOX")
n_run=$(_count "$RUN")
n_review=$(_count "$REVIEW")

total_attention=$((n_brev + n_prev + n_review))

# ── Today's stats from DONE.md ──────────────────────────────────
today=$(date '+%Y-%m-%d')
n_done=0; n_retry=0; n_failed=0; n_needs_review=0

if [ -f "$LOG" ]; then
    today_statuses=$(awk -v d="$today" '
        /^## / { in_today = ($2 == d) }
        in_today && /^\*\*Status:\*\*/ { print }
    ' "$LOG")
    n_done=$(echo "$today_statuses" | grep -c "completed" || true)
    n_retry=$(echo "$today_statuses" | grep -c "requeued" || true)
    n_failed=$(echo "$today_statuses" | grep -c "FAILED" || true)
    n_needs_review=$(echo "$today_statuses" | grep -c "NEEDS REVIEW" || true)
fi

# ── Header ──────────────────────────────────────────────────────
printf '%s  claude-dash%s  ·  %s\n' "${BOLD}${BLUE}" "$RESET" "$(date '+%a %b %-d, %H:%M')"
_sep

# ── Needs Attention ─────────────────────────────────────────────
_section "⚑  NEEDS ATTENTION"

if [ "$total_attention" -eq 0 ]; then
    printf '  %s✓ Nothing needs your attention%s\n' "$GREEN" "$RESET"
else
    printf '  %s%d item(s) require your input%s\n\n' "${BOLD}${YELLOW}" "$total_attention" "$RESET"

    while IFS= read -r name; do
        display=$(echo "$name" | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_[0-9]\{2\}-[0-9]\{2\}_//' | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_//')
        printf '  %s●%s %-40s  %s(backlog for review)%s\n' "$YELLOW" "$RESET" "$display" "$DIM" "$RESET"
    done < <(_list "$BACKLOG_REVIEW")

    while IFS= read -r name; do
        display=$(echo "$name" | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_[0-9]\{2\}-[0-9]\{2\}_//' | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_//')
        printf '  %s●%s %-40s  %s(plan for review)%s\n' "$YELLOW" "$RESET" "$display" "$DIM" "$RESET"
    done < <(_list "$PLAN_REVIEW")

    while IFS= read -r name; do
        display=$(echo "$name" | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_[0-9]\{2\}-[0-9]\{2\}_//' | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_//')
        printf '  %s●%s %-40s  %s(failed, needs review)%s\n' "$RED" "$RESET" "$display" "$DIM" "$RESET"
    done < <(_list "$REVIEW")
fi

# ── Pipeline ────────────────────────────────────────────────────
_section "  PIPELINE"

printf '  '
_stage "drafts" "$n_drafts"
printf ' → '
_stage "backlog" "$n_backlog"
printf ' → '
_stage "prep-review" "$n_brev" warn
printf ' → '
_stage "plan" "$n_plan"
printf ' → '
_stage "plan-review" "$n_prev" warn
printf ' → '
_stage "inbox" "$n_inbox"
printf ' → '
_stage "running" "$n_run"
printf ' → '
_stage "review" "$n_review" warn
printf '\n'

# ── Running ─────────────────────────────────────────────────────
_section "  RUNNING"

running=()
while IFS= read -r name; do
    running+=("$name")
done < <(_list "$RUN")

if [ ${#running[@]} -eq 0 ]; then
    printf '  %s(none)%s\n' "$DIM" "$RESET"
else
    for name in "${running[@]}"; do
        f=$(find "$RUN" -maxdepth 1 -name "${name}*" | head -1)
        elapsed=$(_elapsed "$f")
        # Try all possible session naming patterns (task, prep, draft)
        if tmux has-session -t "claude-${name}" 2>/dev/null || \
           tmux has-session -t "claude-prep-${name}" 2>/dev/null || \
           tmux has-session -t "claude-draft-${name}" 2>/dev/null; then
            status="${GREEN}● live${RESET}"
        else
            status="${YELLOW}○ orphan${RESET}"
        fi
        printf '  %b  %-45s  %s(%s)%s\n' "$status" "$name" "$DIM" "$elapsed" "$RESET"
    done
fi

# ── Today's stats ────────────────────────────────────────────────
_section "  TODAY  $(date '+%Y-%m-%d')"

fail_color=""
[ "$n_failed" -gt 0 ] && fail_color="$RED"
review_color=""
[ "$n_needs_review" -gt 0 ] && review_color="$RED"

printf '  %sCompleted:%s %s%d%s   %sRetried:%s %d   %sFailed:%s %s%d%s   %sNeeds Review:%s %s%d%s\n' \
    "$BOLD" "$RESET" "$GREEN" "$n_done" "$RESET" \
    "$BOLD" "$RESET" "$n_retry" \
    "$BOLD" "$RESET" "$fail_color" "$n_failed" "$RESET" \
    "$BOLD" "$RESET" "$review_color" "$n_needs_review" "$RESET"

# ── By project ───────────────────────────────────────────────────
_section "  BY PROJECT"

declare -A proj_backlog proj_brev proj_plan proj_prev proj_inbox proj_run proj_review

_tally() {
    local dir="$1"
    local -n _map="$2"
    local file proj
    [ -d "$dir" ] || return
    while IFS= read -r name; do
        file=$(find "$dir" -maxdepth 1 -name "${name}*" | head -1)
        proj=$(_get_project "$file")
        [ -z "$proj" ] && proj="other"
        _map[$proj]=$(( ${_map[$proj]:-0} + 1 ))
    done < <(_list "$dir")
}

_tally "$BACKLOG"        proj_backlog
_tally "$BACKLOG_REVIEW" proj_brev
_tally "$PLAN"           proj_plan
_tally "$PLAN_REVIEW"    proj_prev
_tally "$INBOX"          proj_inbox
_tally "$RUN"            proj_run
_tally "$REVIEW"         proj_review

# Collect all project names seen
declare -A all_projects
for p in "${!proj_backlog[@]}" "${!proj_brev[@]}" "${!proj_plan[@]}" "${!proj_prev[@]}" \
         "${!proj_inbox[@]}" "${!proj_run[@]}" "${!proj_review[@]}"; do
    all_projects[$p]=1
done

if [ ${#all_projects[@]} -eq 0 ]; then
    printf '  %s(no tasks in pipeline)%s\n' "$DIM" "$RESET"
else
    for proj in $(echo "${!all_projects[@]}" | tr ' ' '\n' | sort); do
        printf '  %s%-20s%s' "$BOLD" "$proj" "$RESET"
        [ "${proj_backlog[$proj]:-0}" -gt 0 ] && printf '  backlog:%d'      "${proj_backlog[$proj]}"
        [ "${proj_brev[$proj]:-0}"   -gt 0 ] && printf '  %sprep-review:%d%s' "$YELLOW" "${proj_brev[$proj]}" "$RESET"
        [ "${proj_plan[$proj]:-0}"   -gt 0 ] && printf '  plan:%d'          "${proj_plan[$proj]}"
        [ "${proj_prev[$proj]:-0}"   -gt 0 ] && printf '  %splan-review:%d%s' "$YELLOW" "${proj_prev[$proj]}" "$RESET"
        [ "${proj_inbox[$proj]:-0}"  -gt 0 ] && printf '  inbox:%d'         "${proj_inbox[$proj]}"
        [ "${proj_run[$proj]:-0}"    -gt 0 ] && printf '  %srunning:%d%s'   "$GREEN" "${proj_run[$proj]}" "$RESET"
        [ "${proj_review[$proj]:-0}" -gt 0 ] && printf '  %sreview:%d%s'    "$RED" "${proj_review[$proj]}" "$RESET"
        printf '\n'
    done
fi

# ── Recent activity ───────────────────────────────────────────────
_section "  RECENT ACTIVITY"

if [ -f "$LOG" ]; then
    awk '
        /^## [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} - / {
            split($0, h, " - ")
            ts = substr(h[1], 4)   # strip "## "
            name = h[2]
            status = ""
        }
        /^\*\*Status:\*\*/ && name != "" {
            sub(/^\*\*Status:\*\* /, "")
            entries[n++] = ts "|" name "|" $0
        }
        END {
            start = (n > 8) ? n - 8 : 0
            for (i = start; i < n; i++) print entries[i]
        }
    ' "$LOG" | while IFS='|' read -r ts name status; do
        time_part="${ts#* }"  # keep HH:MM only
        # Strip date prefix from name for display
        display=$(echo "$name" | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_//')

        if [[ "$status" == *"completed"* ]];    then icon="${GREEN}✓${RESET}"
        elif [[ "$status" == *"requeued"* ]];   then icon="${YELLOW}↺${RESET}"
        elif [[ "$status" == *"NEEDS REVIEW"* ]]; then icon="${RED}!${RESET}"
        else                                         icon="${RED}✗${RESET}"
        fi

        printf '  %s  %b  %s%-45s%s  %s%s%s\n' \
            "$time_part" "$icon" "$BOLD" "$display" "$RESET" "$DIM" "$status" "$RESET"
    done
else
    printf '  %s(no log yet)%s\n' "$DIM" "$RESET"
fi

printf '\n%s%s%s\n' "$DIM" "$(date '+Updated: %H:%M:%S')  ·  live: while true; do clear; dtask; sleep 30; done" "$RESET"
